# Una sola dirección buena: sin www y por https. Si no, el sitio existe en dos
# direcciones a la vez y Google tiene que adivinar cuál es la de verdad.
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # Medio año exigiendo https: el navegador ya no intenta la versión insegura,
  # ni siquiera la primera vez que alguien teclea el dominio a mano.
  Header always set Strict-Transport-Security "max-age=15552000"

  # Que el navegador no adivine el tipo de un archivo: si decimos que es una
  # imagen, se trata como imagen y no como algo ejecutable.
  Header always set X-Content-Type-Options "nosniff"

  # Al salir del sitio se manda el dominio, no la página concreta que se miraba.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nadie puede encerrar el sitio dentro de un iframe suyo y hacerlo pasar por
  # propio —ni cazar clics encima—, salvo nosotros mismos.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"

  # El sitio no usa cámara, micrófono ni ubicación: se renuncia a ellos de forma
  # explícita, así nada que se cuele en la página puede pedirlos.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
