# Configuración de Apache para el hosting de Hostinger.
# Va en public/, así que Astro lo copia a dist/ y se despliega con el sitio.

# ── Reescritura ────────────────────────────────────────────────────────────
# Activar el motor aquí es lo que aísla esta carpeta del WordPress que hay en
# el public_html de arriba: las reglas de reescritura no se heredan, así que
# al declarar las nuestras las suyas dejan de aplicarse en este directorio.
# Por eso no hace falta tocar el .htaccess del WordPress, que está en
# producción y es mejor no andar moviéndolo.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Cortafuegos contra el WordPress de la carpeta de arriba: cualquier
  # petición que llegue aquí se sirve tal cual y se deja de reescribir.
  # En teoría no hace falta —sus reglas solo actúan sobre rutas que no son
  # un archivo ni una carpeta real, y aquí todas lo son—, pero así tampoco
  # se cuela un 404 nuestro hacia su index.php.
  RewriteRule ^ - [L]

  # ── Sobre HTTPS ──────────────────────────────────────────────────────────
  # No hay regla de redirección a propósito. El borde de Hostinger ya responde
  # 301 de http a https por su cuenta (cabecera «Server: hcdn»), así que la
  # regla sobraría. Y sería peligrosa: si ese proxy termina el TLS y pasa la
  # petición al Apache por http sin la cabecera X-Forwarded-Proto, la regla
  # se dispararía en bucle y el sitio quedaría inaccesible.
</IfModule>

# ── Índice de carpeta ──────────────────────────────────────────────────────
# El sitio usa direcciones de carpeta: /portafolio/ tiene que servir
# /portafolio/index.html. Se declara aquí para no depender de cómo esté
# configurado el servidor.
DirectoryIndex index.html index.php

# ── Comprimir lo que es texto ──────────────────────────────────────────────
# Las imágenes y los vídeos ya vienen comprimidos: volver a comprimirlos solo
# gasta CPU y no ahorra un byte.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ── Caché ──────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Los archivos de /_astro llevan un hash en el nombre: si cambia el
  # contenido cambia el nombre, así que se pueden guardar para siempre.
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  # Medios y tipografías: un mes. Si se sustituye una foto tarda ese tiempo
  # en llegar a quien ya la tenía, y es un plazo razonable.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|mp4|webm|woff2|ico)$">
    ExpiresDefault "access plus 1 month"
    Header set Cache-Control "public"
  </FilesMatch>

  # El HTML no se guarda: es lo que hace que un despliegue se vea enseguida.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Tipos que Apache viejo no conoce ───────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
</IfModule>

# No listar el contenido de las carpetas que no tengan índice.
Options -Indexes
